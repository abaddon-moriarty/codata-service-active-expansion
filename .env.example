# Exemple de variables d'environnement pour le déploiement
# Copier vers .env localement ou injecter directement dans Railway / Render / autre plateforme

PORT=8000
CODATA_USERNAME=your_codata_username
CODATA_PASSWORD=your_codata_password
ANTICAPTCHA_API_KEY=your_anticaptcha_key
SERVICE_API_KEY=replace_with_a_strong_random_key
SESSION_TTL_SECONDS=900

# Optionnel : pour les tests locaux seulement
# FASTAPI_ENV=development
